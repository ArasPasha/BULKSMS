# Firebase Configuration (auth + Firestore for contacts/messages)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Phone gateway (SMS Gateway for Android — local mode)
# These are NOT environment variables — they're configured in-app per user
# under Settings, and stored in your Firestore user profile. Listed here only
# for reference of what you'll need from the phone app's "Local Server" screen:
#   - Gateway URL  (e.g. http://192.168.1.42:8080)
#   - Username
#   - Password
